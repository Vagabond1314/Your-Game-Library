<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true">

    <!-- ШАПКА -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#121212"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:titleEnabled="false"
            app:contentScrim="#000000"
            app:statusBarScrim="#000000"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121212" />

            <!-- ПОСТЕР (Має бути ДО тулбару в коді) -->
            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#262626"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.6">

            <ImageView
                android:id="@+id/detailsImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder" />
        </androidx.cardview.widget.CardView>

        <!-- ТУЛБАР (Тепер він знизу в XML, отже малюється ПОВЕРХ картинки!) -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"
            app:navigationIconTint="#FFFFFF"
            android:theme="@style/MyToolbarTheme"
            app:popupTheme="@style/CustomMenuTheme"/>

    </com.google.android.material.appbar.CollapsingToolbarLayout>
</com.google.android.material.appbar.AppBarLayout>

    <!-- ОСНОВНИЙ КОНТЕНТ -->
    <!-- ОСНОВНИЙ КОНТЕНТ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_overlapTop="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- 1. ГОЛОВНА ІНФА -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/detailsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- СТАТУС (Тепер клікабельний для зміни категорії) -->
                <LinearLayout
                    android:id="@+id/llStatusClickable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/detailsCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  •  "
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/detailsReleased"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Красиві бейджі рейтингів та Ціна Steam -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center">

                        <!-- Юзер Рейтинг -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/item_background"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/btn_star_big_on" app:tint="#FFC107"/>
                            <TextView android:id="@+id/detailsRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFF" android:textStyle="bold" android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Рейтинг критиків -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/item_background"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRITICS" android:textColor="#888" android:textSize="10sp" android:textStyle="bold" android:layout_marginEnd="6dp"/>
                            <TextView android:id="@+id/detailsAggregatedRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#2D5E85" android:textStyle="bold" android:textSize="14sp" />
                        </LinearLayout>

                        <!-- НОВИЙ БЕЙДЖ ЦІНИ ЗІ STEAM -->
                        <LinearLayout
                            android:id="@+id/steamPriceContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/item_background"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical"
                            android:visibility="gone">

                            <!-- Знижка у відсотках -->
                            <TextView
                                android:id="@+id/tvSteamDiscount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#A4D007"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <!-- Стара ціна (буде закреслена в коді) -->
                            <TextView
                                android:id="@+id/tvSteamOriginalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#888888"
                                android:textSize="10sp"
                                android:layout_marginEnd="6dp" />

                            <!-- Фінальна ціна / Або напис Free -->
                            <TextView
                                android:id="@+id/tvSteamFinalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Жанри -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/genresChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="4dp"
                    app:singleLine="false" />
            </LinearLayout>

            <!-- 2. ГОРИЗОНТАЛЬНИЙ РЯДОК ДІЙ ТА МАГАЗИНІВ (Магазини тепер тут!) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Lists Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageCollections"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Lists"
                        android:textColor="#9146FF"
                        app:backgroundTint="#1A9146FF"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_collections"
                        app:iconTint="#9146FF"
                        android:layout_marginEnd="12dp"/>

                    <!-- Вертикальна лінія -->
                    <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333" android:layout_marginEnd="12dp"/>

                    <!-- Магазини (Видно одразу) -->
                    <!-- Кнопки Магазинів -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSteam"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:backgroundTint="#171A21"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_steam"
                        app:iconTint="#FFFFFF"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnXbox"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:backgroundTint="#107C10"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_xbox"
                        app:iconTint="#FFFFFF"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayStation"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:backgroundTint="#003791"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_ps"
                        app:iconTint="#FFFFFF"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNintendo"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:backgroundTint="#E60012"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_nintendo"
                        app:iconTint="#FFFFFF"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenIgdb"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        app:backgroundTint="#333333"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_igdb"
                        app:iconTint="#FFFFFF" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- 1. Completion Stats (Клікабельно для редагування) -->
                    <LinearLayout
                        android:id="@+id/userStatsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/item_background"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- ВАШ ПОТОЧНИЙ КОД userStatsContainer БЕЗ ЗМІН -->

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:letterSpacing="0.05"
                            android:text="COMPLETION STATS"
                            android:textAllCaps="true"
                            android:textColor="#fc6f03"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="30dp"
                            android:layout_height="2dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="#fc6f03" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#262626"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DATES" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" />
                                        <TextView android:id="@+id/tvUserDates" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFF" android:textSize="12sp" android:textStyle="bold" />
                                    </LinearLayout>
                                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E1E1E" />
                                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TYPE" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" />
                                        <TextView android:id="@+id/tvUserType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC107" android:textSize="12sp" android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TIME" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" />
                                        <TextView android:id="@+id/tvUserTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="14sp" android:textStyle="bold" />
                                    </LinearLayout>
                                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1E1E1E" />
                                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLAYS" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" />
                                        <TextView android:id="@+id/tvUserPlays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="14sp" android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E" />

                                <LinearLayout
                                    android:id="@+id/reviewContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:paddingHorizontal="16dp"
                                    android:paddingVertical="10dp"
                                    android:visibility="gone">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REVIEW" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                                    <TextView android:id="@+id/tvUserReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFF" android:textSize="13sp" android:textStyle="italic" android:maxLines="3" android:ellipsize="end" />
                                    <TextView android:id="@+id/tvReviewClickHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Show more..." android:textColor="#fc6f03" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- 2. Wishlisted Stats (Planned) -->
                    <LinearLayout
                        android:id="@+id/userStatsPlannedContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/item_background"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:letterSpacing="0.05" android:text="PLANNED STATS" android:textColor="#2D5E85" android:textSize="14sp" android:textStyle="bold" />
                        <View android:layout_width="30dp" android:layout_height="2dp" android:layout_gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:background="#2D5E85" />
                        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#262626" app:cardCornerRadius="10dp" app:cardElevation="0dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DATE ADDED" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" />
                                        <TextView android:id="@+id/tvUserAdded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="12sp" android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E1E1E" />
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIORITY" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" />
                                        <TextView android:id="@+id/userPriority" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="14sp" android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- 3. Playing Stats -->
                    <LinearLayout
                        android:id="@+id/userStatsPlayingContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/item_background"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:letterSpacing="0.05" android:text="PLAYING STATS" android:textColor="#58A870" android:textSize="14sp" android:textStyle="bold" />
                        <View android:layout_width="30dp" android:layout_height="2dp" android:layout_gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" android:background="#58A870" />
                        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#262626" app:cardCornerRadius="10dp" app:cardElevation="0dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DATE STARTED" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvUserStarted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="12sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- 4. Нативний компактний HLTB (якщо не completed) -->
                    <LinearLayout
                        android:id="@+id/hltbContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/item_background"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAIN" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/image_25" app:tint="#58A870" />
                                <TextView android:id="@+id/tvHltbMain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="--h" android:textColor="#58A870" android:textSize="12sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXTRA" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/image_50" app:tint="#2D5E85" />
                                <TextView android:id="@+id/tvHltbExtras" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="--h" android:textColor="#2D5E85" android:textSize="12sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="24dp" android:background="#333" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#888" android:textSize="9sp" android:textStyle="bold" android:layout_marginBottom="2dp"/>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/image_100" app:tint="#fc6f03" />
                                <TextView android:id="@+id/tvHltbComplete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="--h" android:textColor="#fc6f03" android:textSize="12sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- 4. SUMMARY & STORYLINE -->
                <TextView android:id="@+id/summaryHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Summary" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp" android:visibility="gone" />
                <TextView android:id="@+id/detailsDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#CCCCCC" android:textSize="14sp" android:lineSpacingExtra="4dp" android:visibility="gone" android:maxLines="4" android:ellipsize="end" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
                <TextView android:id="@+id/tvSummaryClickHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Read more..." android:textColor="#58A870" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

                <TextView android:id="@+id/storylineHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Storyline" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp" android:visibility="gone" />
                <TextView android:id="@+id/detailsStoryline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#CCCCCC" android:textSize="14sp" android:lineSpacingExtra="4dp" android:visibility="gone" android:maxLines="4" android:ellipsize="end" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground"/>
                <TextView android:id="@+id/tvStorylineClickHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Read more..." android:textColor="#58A870" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

                <!-- 5. ГАЛЕРЕЯ (Скріншоти тепер там, де мають бути - після тексту) -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Gallery" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="12dp" app:cardBackgroundColor="#1E1E1E" app:cardCornerRadius="16dp" app:cardElevation="0dp">
                    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/screenshotsViewPager" android:layout_width="match_parent" android:layout_height="match_parent" />
                </androidx.cardview.widget.CardView>

                <!-- 6. ТЕХНІЧНА ІНФОРМАЦІЯ (Чіпи) -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Platforms" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/platformsChipGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Languages" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/languagesChipGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Tags" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/tagsChipGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

                <!-- 7. ПОВ'ЯЗАНЕ (Series / Similar) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical">
                    <LinearLayout android:id="@+id/btnSeries" android:visibility="gone" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_details_button" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:id="@+id/tvSeriesTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_media_play" app:tint="#888" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnSimilarGames" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_details_button" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Similar Games" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" />
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_media_play" app:tint="#888" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>