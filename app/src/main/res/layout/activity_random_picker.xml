<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        app:title="Wheel of Fortune"
        app:titleTextColor="#FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <Spinner
                android:id="@+id/spinnerSource"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#58A870" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="20dp"
                android:indeterminateTint="#58A870"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_marginBottom="20dp">
                <com.your_game_library.WheelView
                    android:id="@+id/wheelView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/down_arrow"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvResultName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="Ready to spin!"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSpin"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:backgroundTint="#58A870"
                android:text="SPIN"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnOpenGame"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#fc6f03"
                android:textColor="#FFFFFF"
                android:text="OPEN GAME"
                android:visibility="gone" />

            <!-- СПИСОК КЕРУВАННЯ ІГРАМИ -->
            <LinearLayout
                android:id="@+id/layoutManageHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:visibility="gone"> <!-- Ховаємо за замовчуванням -->

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manage Wheel Entries"
                    android:textColor="#AAAAAA"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/btnAddGameToWheel"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/plus"
                    app:tint="#58A870"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWheelGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>