<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <!-- Картинка гри -->
        <ImageView
            android:id="@+id/gameImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder"
            android:contentDescription="Game Image"
            android:clipToOutline="true"
            android:transitionName="gameImage"/>

        <!-- Градієнт знизу для тексту -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_bottom"/>

        <!-- Контейнер тексту -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:padding="12dp">

            <!-- Назва гри -->
            <TextView
                android:id="@+id/gameName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Контейнер для рейтингів, пріоритету та часу -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <!-- Рейтинг (Зірочка) -->
                <TextView
                    android:id="@+id/gameRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"/>

                <!-- Пріоритет (Суцільний синій кружечок для Planned) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/llPriority"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="11dp"
                    app:cardBackgroundColor="#2D5E85"
                    app:cardElevation="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvGamePriority"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <!-- Час проходження (Суцільна помаранчева капсула для Completed) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/llTimeSpent"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:minWidth="22dp"
                    app:cardCornerRadius="11dp"
                    app:cardBackgroundColor="#fc6f03"
                    app:cardElevation="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvGameTimeSpent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>