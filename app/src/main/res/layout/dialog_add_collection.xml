<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Collection"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Назва -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="#58A870"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <EditText
            android:id="@+id/etCollectionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/search_bg"
            android:hint="e.g. Masterpieces"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="16sp" />

        <!-- Візуальне оформлення -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Appearance"
            android:textColor="#58A870"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvPreviewWrapper"
                android:layout_width="100dp"
                android:layout_height="130dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivCollectionPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickColor"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set Color"
                    android:textColor="#FFFFFF"
                    app:iconTint="#58A870"
                    app:strokeColor="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set Image"
                    android:textColor="#FFFFFF"
                    app:iconTint="#58A870"
                    app:strokeColor="#33FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <!-- Додайте це перед tvQuickAddLabel -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Text Visibility"
            android:textColor="#58A870"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <RadioGroup
            android:id="@+id/rgNameVisibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbShowName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show Name"
                android:textColor="#FFFFFF"
                android:checked="true"
                app:buttonTint="#58A870" />

            <RadioButton
                android:id="@+id/rbHideName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Hide Name"
                android:textColor="#FFFFFF"
                app:buttonTint="#58A870" />
        </RadioGroup>
        <!-- Швидке додавання ігор -->
        <TextView
            android:id="@+id/tvQuickAddLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quick Add Games"
            android:textColor="#58A870"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuickAddGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>