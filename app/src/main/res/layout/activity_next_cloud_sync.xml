<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarNextCloud"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="NextCloud Sync"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server URL (with https://)"
            android:textColor="#58A870"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etNextCloudServer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/search_bg"
            android:hint="https://your-nextcloud.com"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="#58A870"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etNextCloudUser"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/search_bg"
            android:hint="user"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Password"
            android:textColor="#58A870"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etNextCloudPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/search_bg"
            android:hint="abcd-efgh-ijkl-mnop"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backup Frequency"
            android:textColor="#58A870"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <RadioGroup
                android:id="@+id/radioGroupFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbDaily"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Every Day"
                    android:textColor="#FFFFFF"
                    app:buttonTint="#58A870" />

                <RadioButton
                    android:id="@+id/rbWeekly"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Every Week"
                    android:textColor="#FFFFFF"
                    app:buttonTint="#58A870" />

                <RadioButton
                    android:id="@+id/rbMonthly"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Every Month"
                    android:textColor="#FFFFFF"
                    app:buttonTint="#58A870" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>
        <Button
            android:id="@+id/btnSaveNextCloud"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SAVE &amp; ENABLE AUTO-SYNC"
            android:backgroundTint="#58A870"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnSyncNow"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Sync Now"
            android:textColor="#FFFFFF"
            app:strokeColor="#58A870"
            app:cornerRadius="12dp" />
        <!-- Додайте після кнопки btnSyncNow -->
        <Button
            android:id="@+id/btnDownloadFromCloud"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Download &amp; Restore from Cloud"
            android:textColor="#fc6f03"
            app:strokeColor="#fc6f03"
            app:cornerRadius="12dp" />

    </LinearLayout>
</LinearLayout>