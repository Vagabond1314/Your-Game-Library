<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF"> <!-- Колір відблиску при натисканні -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#252525" /> <!-- Колір кнопки (трохи світліший за фон) -->
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#333333" /> <!-- Тонка рамка для об'єму -->
        </shape>
    </item>
</ripple>